{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-work-assurance:evidenceguard:claim-evidence:0.1",
  "title": "EvidenceGuard Claim-Evidence Audit",
  "description": "Portable output contract for EvidenceGuard V0.1 claim-evidence integrity audits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_version",
    "audit_scope",
    "claims",
    "summary",
    "limitations",
    "escalations"
  ],
  "properties": {
    "audit_version": {
      "const": "0.1"
    },
    "audit_scope": {
      "$ref": "#/$defs/auditScope"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimAssessment"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "escalations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/escalation"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "auditScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_name",
        "audit_date",
        "evidence_boundary"
      ],
      "properties": {
        "target_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "audit_date": {
          "type": "string",
          "format": "date"
        },
        "evidence_boundary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "document_date": {
          "type": "string",
          "format": "date"
        },
        "intended_use": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "jurisdiction_or_scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "freshness_rule": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "claimAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_text",
        "location",
        "claim_type",
        "support_status",
        "evidence",
        "findings"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "claim_text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "location": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "factual",
            "numeric",
            "comparative",
            "causal",
            "requirement",
            "forecast_or_estimate",
            "other"
          ]
        },
        "support_status": {
          "type": "string",
          "enum": [
            "supported",
            "partially_supported",
            "unsupported",
            "indeterminate"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRecord"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_label",
        "locator",
        "actual_role",
        "access_status",
        "support_note"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "actual_role": {
          "type": "string",
          "enum": [
            "observed_result",
            "estimate",
            "forecast",
            "target",
            "definition",
            "requirement",
            "expert_opinion",
            "contextual_background",
            "method_or_design",
            "other"
          ]
        },
        "access_status": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "metadata_only",
            "inaccessible"
          ]
        },
        "publication_or_effective_date": {
          "type": "string",
          "format": "date"
        },
        "support_note": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "type",
        "severity",
        "explanation",
        "evidence_basis",
        "remediation"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "type": "string",
          "enum": [
            "unsupported_factual_claim",
            "partial_support",
            "citation_role_mismatch",
            "stale_or_insufficient_source",
            "causal_overclaim",
            "numeric_inconsistency",
            "unclear_population_or_timeframe"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "explanation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_basis": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "remediation": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_claims",
        "supported",
        "partially_supported",
        "unsupported",
        "indeterminate",
        "total_findings",
        "findings_by_type"
      ],
      "properties": {
        "total_claims": {
          "type": "integer",
          "minimum": 0
        },
        "supported": {
          "type": "integer",
          "minimum": 0
        },
        "partially_supported": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "indeterminate": {
          "type": "integer",
          "minimum": 0
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "findings_by_type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unsupported_factual_claim",
            "partial_support",
            "citation_role_mismatch",
            "stale_or_insufficient_source",
            "causal_overclaim",
            "numeric_inconsistency",
            "unclear_population_or_timeframe"
          ],
          "properties": {
            "unsupported_factual_claim": {
              "type": "integer",
              "minimum": 0
            },
            "partial_support": {
              "type": "integer",
              "minimum": 0
            },
            "citation_role_mismatch": {
              "type": "integer",
              "minimum": 0
            },
            "stale_or_insufficient_source": {
              "type": "integer",
              "minimum": 0
            },
            "causal_overclaim": {
              "type": "integer",
              "minimum": 0
            },
            "numeric_inconsistency": {
              "type": "integer",
              "minimum": 0
            },
            "unclear_population_or_timeframe": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ids",
        "blocked_decision",
        "needed_evidence_or_authority",
        "reason"
      ],
      "properties": {
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "blocked_decision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "needed_evidence_or_authority": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
